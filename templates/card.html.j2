{% import 'macros.html.j2' as m %}
{% set body %}
<div style="width: 768px; height: 480px; box-sizing: border-box; padding: 32px 40px; display: flex; flex-direction: column; gap: 12px; background: #FFFFFF; color: #000000; font-family: 'IBM Plex Sans', sans-serif; overflow: hidden">
{{ m.running_head(r.code, r.name, 'Component card · 8 × 5 in', r.rev, r.date, 'Card') }}

<div style="display: flex; flex-direction: column; gap: 3px"><h1 style="margin: 0; font-size: 24px; line-height: 28px; font-weight: 600; letter-spacing: -0.015em">{{ r.name }}</h1><p style="margin: 0; font-size: 12px; line-height: 16px"><span style="color: #5C5C5C">Yield</span> {{ r['yield'] }}<span style="color: #5C5C5C; margin: 0 6px">·</span><span style="color: #5C5C5C">Keeps</span> {{ r.keeps }}<span style="color: #5C5C5C; margin: 0 6px">·</span><span style="color: #5C5C5C">Basis</span> % · {{ r.basis }}<span style="color: #5C5C5C; margin: 0 6px">·</span><span style="color: #5C5C5C">Contains</span> <span style="font-weight: 600">{{ r.contains|join(' · ') }}</span><span style="color: #5C5C5C; margin: 0 6px">·</span><span style="color: #5C5C5C">Source</span> {{ r.source }}</p></div>

<div style="display: grid; grid-template-columns: 300px minmax(0, 1fr); column-gap: 24px; padding-top: 10px; border-top: 1px solid #000000">
<div style="display: flex; flex-direction: column; gap: 8px"><table style="width: 100%; border-collapse: collapse; table-layout: fixed; font-variant-numeric: tabular-nums"><thead><tr><th style="width: 20px; padding: 0 0 5px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: right"></th><th style="width: auto; padding: 0 0 5px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: left">Ingredient</th><th style="width: 48px; padding: 0 0 5px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: right">%</th><th style="width: 48px; padding: 0 0 5px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: right">Grams</th></tr></thead><tbody>{% set pad = '2px 0' if r.dense or r.formula.rows|length > 9 else '3px 0' %}{% for row in r.formula.rows %}{% set b = '1px solid #000000' if loop.last else '1px solid #BDBDBD' %}<tr><td style="padding: {{ pad }}; border-bottom: {{ b }}"><span style="display: inline-block; width: 10px; height: 10px; border: 1px solid #000000"></span></td><td style="padding: {{ pad }}; border-bottom: {{ b }}; font-size: 13px; line-height: 18px">{{ row.name }}{% if row.dagger %} †{% endif %}{% if row.note %} <span style="color: #5C5C5C">· {{ row.note }}</span>{% endif %}</td><td style="padding: {{ pad }}; border-bottom: {{ b }}; font-size: 13px; line-height: 18px; text-align: right; color: #5C5C5C">{{ row.pct }}</td><td style="padding: {{ pad }}; border-bottom: {{ b }}; font-size: 13px; line-height: 18px; text-align: right; font-weight: 500">{{ row.g_fmt }}</td></tr>{% endfor %}<tr><td></td><td style="padding: {{ pad }}; font-size: 13px; line-height: 18px; font-weight: 600">{{ r.formula.total.label }}</td><td style="padding: {{ pad }}; font-size: 13px; line-height: 18px; text-align: right; color: #5C5C5C">{{ r.formula.total.pct }}</td><td style="padding: {{ pad }}; font-size: 13px; line-height: 18px; text-align: right; font-weight: 600">{{ r.formula.total.g_fmt }}</td></tr></tbody></table>
{% if r.formula_note %}<p style="margin: 0; font-size: 12px; line-height: 16px; color: #5C5C5C">{{ r.formula_note }}</p>{% endif %}</div>
<div style="display: flex; flex-direction: column; gap: 5px"><span style="font-size: 12px; line-height: 16px; font-weight: 600">Method</span><ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: 1px solid #000000">{% for s in r.method %}<li style="display: grid; grid-template-columns: 16px minmax(0, 1fr) 76px 12px; column-gap: 10px; padding: 5px 0; border-bottom: 1px solid {{ '#000000' if loop.last else '#BDBDBD' }}; font-size: 13px; line-height: 18px"><span style="font-weight: 600">{{ loop.index }}</span><p style="margin: 0"><strong style="font-weight: 600">{{ s.head }}</strong> {{ s.text }}</p><span style="font-size: 12px; line-height: 18px; text-align: right">{% if s.time == '—' or not s.time %}<span style="color: #5C5C5C">—</span>{% else %}{{ s.time }}{% endif %}{% if s.target %}<br>{{ s.target }}{% endif %}</span><span style="width: 10px; height: 10px; border: 1px solid #000000; margin-top: 4px"></span></li>{% endfor %}</ol>
{% if r.note %}<p style="margin: 4px 0 0; font-size: 12px; line-height: 16px; color: #5C5C5C">{{ r.note }}</p>{% endif %}</div>
</div>
</div>
{% endset %}
{{ m.doc(r.name ~ ' — Component Card', 768, 480, body) }}
