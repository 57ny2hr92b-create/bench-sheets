{% import 'macros.html.j2' as m %}
{% macro cell(t, extra='') %}<td style="padding: 4px 0; border-bottom: 1px solid #BDBDBD; font-size: 13px; line-height: 18px;{{ extra }}">{{ t }}</td>{% endmacro %}
{% set body %}
<div style="width: 816px; height: 1056px; box-sizing: border-box; padding: 48px 60px; display: flex; flex-direction: column; gap: 20px; background: #FFFFFF; color: #000000; font-family: 'IBM Plex Sans', sans-serif; overflow: hidden">
{{ m.running_head('IX-00', lib.title, 'Index', 'Rev %02d' % lib.index.rev, lib.index.date, page.n ~ ' / ' ~ page.total) }}

{% if page.n == 1 %}<div style="display: flex; flex-direction: column; gap: 4px">
<h1 style="margin: 0; font-size: 40px; line-height: 44px; font-weight: 600; letter-spacing: -0.02em">{{ lib.title }}</h1>
<p style="margin: 0; font-size: 15px; line-height: 22px; color: #5C5C5C">{{ lib.lede }}</p>
</div>
{% endif %}
<section style="display: flex; flex-direction: column; gap: 8px; padding-top: 10px; border-top: 1px solid #000000"><div style="display: flex; justify-content: space-between; align-items: baseline"><h2 style="margin: 0; font-size: 14px; line-height: 18px; font-weight: 600">Index</h2><span style="font-size: 12px; line-height: 16px; color: #5C5C5C">By family · one tab each · cards file behind their family</span></div><table style="width: 100%; border-collapse: collapse; table-layout: fixed; font-variant-numeric: tabular-nums"><thead><tr><th style="width: 64px; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: left">Code</th><th style="width: auto; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: left">Recipe</th><th style="width: 88px; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: left">Format</th><th style="width: 32px; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: right">Pp</th><th style="width: 40px; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: right">Rev</th><th style="width: 20px; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: left"></th><th style="width: 148px; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: left">Linked</th><th style="width: 160px; padding: 0 0 6px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 500; color: #5C5C5C; text-align: left">Contains</th></tr></thead><tbody>{% for fam in page.families %}<tr><td colspan="8" style="padding: 12px 0 4px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 600">{{ fam.code }}&nbsp;&nbsp;{{ fam.name }}</td></tr>{% for e in fam.entries %}<tr>{% if site %}{{ cell('<a href="' ~ e.code ~ '.html" style="text-decoration: none">' ~ e.code ~ '</a>', ' font-weight: 600') }}{{ cell('<a href="' ~ e.code ~ '.html" style="text-decoration: none">' ~ e.name ~ '</a>') }}{% else %}{{ cell(e.code, ' font-weight: 600') }}{{ cell(e.name) }}{% endif %}{% if site and ' + tent' in e.format %}{{ cell(e.format.replace(' + tent', ' + <a href="' ~ e.code ~ '-tent.html" style="color: #5C5C5C">tent</a>'), ' color: #5C5C5C') }}{% else %}{{ cell(e.format, ' color: #5C5C5C') }}{% endif %}{{ cell(e.pages, ' text-align: right') }}{{ cell('%02d' % e.rev, ' text-align: right') }}{{ cell('') }}{% if e.linked %}{{ cell(e.linked) }}{% else %}{{ cell('—', ' color: #5C5C5C') }}{% endif %}{{ cell(e.contains) }}</tr>{% endfor %}{% endfor %}{% if page.blank_rows %}<tr><td colspan="8" style="padding: 12px 0 4px; border-bottom: 1px solid #000000; font-size: 12px; line-height: 16px; font-weight: 600">New entries</td></tr>{% for _ in range(page.blank_rows) %}<tr>{% for _ in range(8) %}<td style="padding: 4px 0; height: 18px; border-bottom: 1px solid #BDBDBD"></td>{% endfor %}</tr>{% endfor %}{% endif %}</tbody></table></section>

<div style="margin-top: auto; display: flex; gap: 24px; padding-top: 8px; border-top: 1px solid #BDBDBD; font-size: 12px; line-height: 16px"><span><span style="font-weight: 600">Punch left.</span> <span style="color: #5C5C5C">The 60 px margin clears a 3-hole punch.</span></span><span><span style="font-weight: 600">Protect page 1.</span> <span style="color: #5C5C5C">Write on page 2+.</span></span><span><span style="font-weight: 600">Replace, don’t amend.</span> <span style="color: #5C5C5C">Old Revs to the back of the tab.</span></span></div>
</div>
{% endset %}
{{ m.doc(lib.title ~ ' — Index', 816, 1056, body) }}
